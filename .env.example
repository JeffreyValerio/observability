# Copiar este archivo a .env y completar con los valores del tenant de Dynatrace
# (SaaS trial gratuito es suficiente: https://www.dynatrace.com/trial/)

# URL del entorno de Dynatrace, ej: https://abc12345.live.dynatrace.com
DT_ENVIRONMENT_URL=

# Token de instalación de OneAgent (Access Tokens > PaaS token, o el token
# que genera el asistente "Deploy Dynatrace" del tenant)
ONEAGENT_INSTALLER_TOKEN=

# Token de API v2 (Access Tokens) con scopes de lectura de métricas/problemas
# y de gestión de Workflows, usado para consultar Davis AI y desplegar el
# Workflow de notificación de forma reproducible.
DT_API_TOKEN=

# URL a la que el load-generator envía tráfico (el balanceador nginx)
FRONTEND_URL=http://frontend

# Probabilidad (0-1) de que cada iteración del load-generator dispare un
# endpoint de caos en vez de tráfico normal
CHAOS_PROBABILITY=0.05
